OUTPUT_FILE=Dexcom_Job_Tracker.xlsx
# Public LinkedIn Jobs discovery settings.
RESULTS_PER_QUERY=200
# Public LinkedIn card loading is asynchronous. These limits avoid stopping before all cards load.
LINKEDIN_MAX_SCROLLS=20
LINKEDIN_STABLE_ROUNDS=3
BROWSER_HEADLESS=false
COMPANY_NAME=Dexcom
# Optional geographic coverage expansion only, also separated with ||.
DISCOVERY_GEO_QUERIES=
